                    "iri": "/api/3/assets/{{vars.item.uuid}}",
                    "body": "",
                    "method": "DELETE"
                },
                "version": "3.7.0",
                "for_each": {
                    "item": "{{ vars.steps.Find_Stale_Assets.data['hydra:member'] | default([]) | selectattr('duplicateStatus','equalto','duplicate-old') | selectattr('modifyDate','le',(vars.cutoffTs | int)) | list }}",
                    "parallel": false,
                    "condition": ""
                },
                "connector": "cyops_utilities",
                "operation": "make_cyops_request",
                "operationTitle": "FSR: Make FortiSOAR API Call",
