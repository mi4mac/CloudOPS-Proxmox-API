        {
            "@type": "WorkflowStep",
            "name": "Set Summary",
            "description": null,
            "arguments": {
                "summary_message": "{% set c = (vars.steps.Find_Stale_Assets.data['hydra:member'] | default([]) | selectattr('duplicateStatus','equalto','duplicate-old') | selectattr('modifyDate','le',(vars.cutoffTs | int)) | list | length) %}{% set m = (vars.input.params.maxDelete | default(1000) | int) %}{% if c == 0 %}No duplicate-old assets matched cutoff {{ vars.cutoffTs }}.{% elif c > m %}Safety stop: {{ c }} candidates exceed maxDelete={{ m }}. No deletions executed.{% elif vars.input.params.dryRun | default(true) %}Dry-run: {{ c }} duplicate-old assets older than cutoff {{ vars.cutoffTs }}. No deletions executed.{% else %}Deleted {{ c }} duplicate-old assets older than cutoff {{ vars.cutoffTs }}.{% endif %}"
            },
            "status": null,
            "top": "840",
